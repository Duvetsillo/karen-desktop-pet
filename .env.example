# Copy to .env for Docker Compose. Never commit .env or secrets/.
# Use your own trusted HTTPS origin, without path or trailing slash.
KAREN_PUBLIC_ORIGIN=https://karen.example.com
# Existing OpenClaw Gateway; Karen does not start or replace it.
KAREN_GATEWAY_URL=wss://openclaw.example.com
KAREN_AGENT_ID=main
# Native Windows optional speech resources:
# KAREN_PROJECT_ROOT=/absolute/path/to/your/voice-resources
